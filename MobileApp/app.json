{
  "expo": {
    "name": "Rozare",
    "slug": "rozare",
    "version": "1.0.8",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "rozare",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Rozare is an AI-powered marketplace where shoppers discover products from independent sellers and brands, while sellers manage their stores with dashboard tools, AI chat, WhatsApp workflows, secure checkout, order status updates, and multi-currency support.",
    "backgroundColor": "#F4F8FF",
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/android-legacy-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0EA5E9"
      },
      "package": "com.rozare.app",
      "versionCode": 9,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rozare.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rozare.app",
      "buildNumber": "9",
      "associatedDomains": [
        "applinks:rozare.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Rozare needs camera access to let you take product photos.",
        "NSPhotoLibraryUsageDescription": "Rozare needs photo library access to let you upload product images.",
        "NSMicrophoneUsageDescription": "Rozare needs microphone access so you can send voice notes to the AI assistant."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8FF",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#EEF4FF",
            "image": "./assets/splash.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Rozare"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "rozare",
          "project": "rozare-mobile"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-system-ui",
      "expo-asset",
      "expo-image",
      "expo-sharing",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "./plugins/withPinnedStripeAndroid",
        {
          "version": "23.3.0"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/21e1e6b1-bb29-47bc-a337-236fb17314cf",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "en": "./locales/en.json"
    },
    "primaryColor": "#6366f1",
    "extra": {
      "eas": {
        "projectId": "21e1e6b1-bb29-47bc-a337-236fb17314cf"
      }
    },
    "owner": "rozare"
  }
}
