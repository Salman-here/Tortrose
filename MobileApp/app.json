{
  "expo": {
    "name": "Rozare - AI Marketplace",
    "slug": "rozare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rozare",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Rozare is an AI-powered marketplace where shoppers discover products from independent sellers and brands, while sellers manage their stores with dashboard tools, AI chat, WhatsApp workflows, secure checkout, order status updates, and multi-currency support.",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.rozare.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rozare.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rozare.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:rozare.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Rozare needs camera access to let you take product photos.",
        "NSPhotoLibraryUsageDescription": "Rozare needs photo library access to let you upload product images.",
        "NSMicrophoneUsageDescription": "Rozare needs microphone access so you can send voice notes to the AI assistant."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Rozare"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "rozare",
          "project": "rozare-mobile"
        }
      ],
      "@sentry/react-native",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-sharing"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "en": "./locales/en.json"
    },
    "primaryColor": "#6366f1"
  }
}
