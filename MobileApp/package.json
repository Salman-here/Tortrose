{
  "name": "mobile-app",
  "version": "1.0.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate:build-config": "node scripts/validate-build-config.js",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "update:preview": "npx eas-cli update --channel preview --environment preview --platform android",
    "update:production": "npx eas-cli update --channel production --environment production",
    "eas-build-post-install": "npm run validate:build-config"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.63.0",
    "axios": "^1.19.0",
    "expo": "~55.0.29",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.17",
    "expo-auth-session": "~55.0.18",
    "expo-blur": "~55.0.17",
    "expo-clipboard": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.18",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.17",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.23",
    "expo-linear-gradient": "~55.0.17",
    "expo-local-authentication": "~55.0.17",
    "expo-notifications": "~55.0.26",
    "expo-print": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-sharing": "~55.0.23",
    "expo-speech": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.17",
    "expo-system-ui": "~55.0.21",
    "expo-updates": "~55.0.27",
    "expo-web-browser": "~55.0.19",
    "libphonenumber-js": "^1.12.42",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/parser": "^7.29.7",
    "@testing-library/react-native": "^12.4.3",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.0"
  },
  "overrides": {
    "@react-native/community-cli-plugin": {
      "metro": "0.83.8",
      "metro-config": "0.83.8"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testEnvironment": "node"
  }
}
